# Configurazione Supabase
# Copia questo file in ".env.local" e inserisci i valori del tuo progetto Supabase.
# Puoi trovare questi valori in: Supabase Dashboard > Project Settings > API.
#
# IMPORTANTE: non inserire mai la "service_role key" nel frontend.
# La "anon key" e' pubblica per design ed e' protetta dalle policy di Row Level Security.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Valuta predefinita dell'applicazione
VITE_DEFAULT_CURRENCY=EUR
